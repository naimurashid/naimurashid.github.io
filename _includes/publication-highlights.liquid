{% assign highlights = site.data.publication_highlights | default: empty %}
{% if highlights != empty %}
  <div class="publication-highlights">
    {% for item in highlights %}
      <article class="publication-highlights__card">
        <header>
          <h3>{{ item.title }}</h3>
          <p class="publication-highlights__journal">{{ item.journal }}</p>
        </header>
        <p class="publication-highlights__summary">{{ item.summary }}</p>
        <div class="publication-highlights__meta">
          {% if item.link %}
            <a class="btn btn-sm btn-outline-primary" href="{{ item.link }}" target="_blank" rel="noopener">Read study</a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
