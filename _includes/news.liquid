<div class="news news-cards">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <div class="news-cards__grid">
      {% for item in news limit: news_limit %}
        <article class="news-card">
          <p class="news-card__date">{{ item.date | date: '%b %d, %Y' }}</p>
          {% if item.inline %}
            <p class="news-card__inline">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</p>
          {% else %}
            <a class="news-card__title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% assign teaser = item.description | default: item.excerpt | default: item.content %}
            {% if teaser %}
              <p class="news-card__summary">{{ teaser | strip_html | truncate: 140 }}</p>
            {% endif %}
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
