{% assign items = site.data.gillings_news | sort: 'date' | reverse %}
{% if items != empty %}
  <div class="gillings-news">
    {% for item in items %}
      <article class="gillings-news__item">
        <div class="gillings-news__meta">
          <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: "%b %-d, %Y" }}</time>
          <span>{{ item.outlet | default: "Gillings News" }}</span>
        </div>
        <h3><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a></h3>
        <p>{{ item.summary }}</p>
      </article>
    {% endfor %}
  </div>
{% endif %}
