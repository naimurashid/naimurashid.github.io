{% assign updates = site.data.social_curated | default: empty %}
{% if updates == empty %}
  {% assign updates = site.social_feed.entries | default: empty %}
{% endif %}
{% if updates != empty %}
  {% assign sorted = updates | sort: 'date' | reverse %}
  {% if site.social_feed.limit %}
    {% assign sorted = sorted | slice: 0, site.social_feed.limit %}
  {% endif %}
  <div class="social-feed">
    {% for update in sorted %}
      {% assign platform = update.platform | default: 'update' %}
      {% assign badge_key = platform | downcase %}
      {% assign badge_class = site.social_feed.badges[badge_key] | default: site.social_feed.badges.default %}
      <article class="social-feed__card">
        <header class="social-feed__header">
          <span class="badge {{ badge_class }}">{{ platform }}</span>
          {% if update.date %}
            <time datetime="{{ update.date | date_to_xmlschema }}" class="social-feed__date">
              {{ update.date | date: site.social_feed.date_format | default: "%b %-d, %Y" }}
            </time>
          {% endif %}
        </header>
        <h3 class="social-feed__title">
          {% if update.url %}
            <a href="{{ update.url }}" target="_blank" rel="noopener noreferrer">
              {{ update.title }}
            </a>
          {% else %}
            {{ update.title }}
          {% endif %}
        </h3>
        {% if update.summary %}
          <p class="social-feed__summary">{{ update.summary }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
{% else %}
  <p class="text-muted">No social updates available yet.</p>
{% endif %}
