---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        <!-- {{ site.title }} -->
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile and page.hero_profile != true %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
           <div class="more-info">{{ page.profile.more_info }}</div> 
        {% endif %} 
         {% if page.profile.address %} 
        <div class="address">
          <p>
            {% if page.profile.href %}<a href="{{ page.profile.href | relative_url }}">{% endif %}
              <span class="name">{{ page.profile.name }}</span>
            {% if page.profile.href %}</a>{% endif %}
              <span class="data">
            {% if page.profile.position %}<br />{{ page.profile.position }}{% endif %}
            {% if page.profile.email %}<br /><a href="mailto:{{ page.profile.email }}"><i class="fas fa-envelope"></i> {{ page.profile.email }}</a>{% endif %}
            {% if page.profile.phone %}<br /><a href="tel:{{ page.profile.phone }}"><i class="fas fa-phone"></i> {{ page.profile.phone }}</a>{% endif %}
            {% if page.profile.orcid %}<br /><a href="https://orcid.org/{{ page.profile.orcid }}" target="_blank"><i class="fab fa-orcid"></i> {{ page.profile.orcid }}</a>{% endif %}
            {% if page.profile.twitter %}<br /><a href="https://twitter.com/{{ page.profile.twitter }}" target="_blank"><i class="fab fa-twitter"></i> {{ page.profile.twitter }}</a>{% endif %}
            {% if page.profile.github %}<br /><a href="https://github.com/{{ page.profile.github }}" target="_blank"><i class="fab fa-github"></i> {{ page.profile.github }}</a>{% endif %}
            {% if page.profile.website %}<br /><a href="{{ page.profile.website }}" target="_blank"><i class="fas fa-globe"></i> {{ page.profile.website }}</a>{% endif %}
            </span>                  
          </p>
          <p class="post">{{ page.profile.address }}</p>
          {% assign linkedin_url = page.profile.linkedin %}
          {% if linkedin_url %}
            {% unless linkedin_url contains '://' %}
              {% assign linkedin_url = 'https://www.linkedin.com/in/' | append: page.profile.linkedin | append: '/' %}
            {% endunless %}
          {% endif %}
          {% assign github_url = page.profile.github %}
          {% if github_url %}
            {% unless github_url contains '://' %}
              {% assign github_url = 'https://github.com/' | append: page.profile.github | append: '/' %}
            {% endunless %}
          {% endif %}
          {% if page.profile.linkedin or page.profile.website or page.profile.github %}
            <div class="profile-badges">
              {% if page.profile.linkedin %}
                <a href="{{ linkedin_url }}" class="badge badge-social badge-social--linkedin" target="_blank" rel="noopener">
                  <i class="fab fa-linkedin"></i> LinkedIn
                </a>
              {% endif %}
              {% if page.profile.website %}
                <a href="{{ page.profile.website }}" class="badge badge-social badge-social--website" target="_blank" rel="noopener">
                  <i class="fas fa-globe"></i> Personal Site
                </a>
              {% endif %}
              {% if page.profile.github %}
                <a href="{{ github_url }}" class="badge badge-social badge-social--github" target="_blank" rel="noopener">
                  <i class="fab fa-github"></i> GitHub
                </a>
              {% endif %}
            </div>
          {% endif %}
          <!--{% if page.profile.logos %}-->
          <!--<div><a href="https://inbt.jhu.edu"><img class="layout_commented"  style="margin-bottom: 20px" img src="{{ '/assets/img/logos/INBT-logo.png' |   relative_url }}" height="60"></a> -->
          <!--  <a href="https://breakthroughcancer.org"><img class="layout_commented" style="margin-bottom: 20px" img src="{{ '/assets/img/logos/BTC-logo.png' |   relative_url }}" height="60" ></a> -->
          <!-- </div> -->
          <!-- {% endif %} -->
        </div>
      {% endif %}
          </div>
          {%- endif %}

    

    <div class="clearfix">
            {{ content }}
          </div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <p class="section-eyebrow">Lab updates</p>
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.social_feed and site.social_feed.enabled %}
      <p class="section-eyebrow">Latest updates</p>
      <h2>
        {{ site.social_feed.title | default: "Latest updates" }}
      </h2>
      {% include social-feed.liquid %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.lab_publications %}
      <h2>Key Lab Publications</h2>
      <ol class="member-publications">
        {% for pub in page.lab_publications %}
          <li>
            {% assign pubkey = pub.key %}
            {% reference pubkey -T member-reference %}
            {% if pub.label %}
              <span class="member-publications__tag">{{ pub.label }}</span>
            {% endif %}
            {% if pub.links %}
              <div class="member-publications__links">
                {% for link in pub.links %}
                  <a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.text }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
